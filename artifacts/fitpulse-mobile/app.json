{
  "expo": {
    "name": "FitPulse",
    "slug": "fitpulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitpulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMotionUsageDescription": "FitPulse reads your iPhone's step history to show your daily and hourly movement, including walks while the screen was locked."
      },
      "bundleIdentifier": "com.fitpulse.app"
    },
    "android": {
      "package": "com.fitpulse.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}