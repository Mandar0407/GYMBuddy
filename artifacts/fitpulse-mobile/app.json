{
  "expo": {
    "name": "GYM Buddy",
    "slug": "fitpulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gym-buddy-icon.png",
    "scheme": "fitpulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMotionUsageDescription": "GYM Buddy reads your iPhone's step history to show your daily and hourly movement, including walks while the screen was locked."
      },
      "bundleIdentifier": "com.fitpulse.app"
    },
    "android": {
      "package": "com.fitpulse.app"
    },
    "web": {
      "favicon": "./assets/images/gym-buddy-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "GymBuddyTodayWidget",
              "displayName": "GYM Buddy Today",
              "description": "Today's logged nutrition, water, movement, and strength progress.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}